{
  "name": "NSFW Guard Bot",
  "description": "A Telegram NSFW guard bot using Pyrogram and NudeNet",
  "repository": "https://github.com/yourusername/yourrepo",
  "keywords": ["telegram", "bot", "nsfw", "pyrogram", "heroku"],
  "env": {
    "API_ID": {
      "description": "Get this from https://my.telegram.org/apps",
      "required": true
    },
    "API_HASH": {
      "description": "Get this from https://my.telegram.org/apps",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Your Telegram bot token from @BotFather",
      "required": true
    },
    "MONGO_URI": {
      "description": "Your MongoDB connection URI",
      "required": true
    },
    "NSFW_THRESHOLD": {
      "description": "Threshold for NSFW detection (default 0.75)",
      "required": false
    },
    "NSFW_STICKER_LIMIT": {
      "description": "Number of NSFW stickers before mute (default 3)",
      "required": false
    },
    "MUTE_DURATION_SECONDS": {
      "description": "Mute duration in seconds (default 86400 = 1 day)",
      "required": false
    },
    "LOG_CHAT_ID": {
      "description": "Telegram Chat ID for admin logs",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "ECO"
    }
  },
  "image": "heroku/python"
}
