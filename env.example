```env
# Copy this to .env (do NOT commit real secrets). Then set these keys on Heroku config vars.

API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
MONGO_URI=mongodb+srv://user:pass@cluster0.mongodb.net/dbname?retryWrites=true&w=majority

# Optional tuning
NSFW_THRESHOLD=0.75
NSFW_STICKER_LIMIT=3
MUTE_DURATION_SECONDS=86400

# Optional: Phoenix / log channel (chat id or @username)
LOG_CHAT_ID=@yourlogchannel_or_-1001234567890
```